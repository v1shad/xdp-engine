[Unit]
Description=XDP Engine (Firewall & SOAR)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/xdp-engine
# By default, runs in DETECT mode on eth0. Add --enforce to drop traffic.
ExecStart=/opt/xdp-engine/engine eth0
ExecStop=/opt/xdp-engine/engine cleanup eth0
Restart=on-failure

[Install]
WantedBy=multi-user.target
